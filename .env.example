AWS_REGION="us-east-1"
environment="production"

# ── Credenciais do Aurora para o secret do DMS ────────────────────────────
# VPC, subnets, endpoint, porta e db_name são descobertos automaticamente
# via Terraform data sources a partir de:
#   - vpc_name (tfvars) → lookup VPC por tag Name
#   - aurora_cluster_identifier (tfvars) → lookup cluster Aurora
#
# Estes valores são usados para CRIAR o secret no Secrets Manager quando ele
# ainda não existir, e são exportados como TF_VAR_db_* para o Terraform.
DB_HOST=""
DB_PORT="5432"
DB_NAME=""
DB_USER=""
DB_PASSWORD=""

# ── Secret do DMS (nome NÃO versionado — fica apenas no .env) ─────────────
# Nome do secret no Secrets Manager com as credenciais do Aurora.
# É exportado como TF_VAR_db_secret_name para o Terraform e usado pelos
# scripts deploy.sh e destroy.sh. Preencha com o nome real.
#
# Comportamento do deploy:
#   - Se o secret JÁ EXISTE com este nome → é REUTILIZADO (não é sobrescrito).
#   - Se NÃO existe → é CRIADO automaticamente com DB_HOST/DB_PORT/DB_NAME/
#     DB_USER/DB_PASSWORD.
DB_SECRET_NAME=""
