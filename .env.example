AWS_REGION="us-east-1"
environment="production"

# ── Credenciais do Aurora para o secret do DMS ────────────────────────────
# VPC, subnets, endpoint, porta e db_name são descobertos automaticamente
# via Terraform data sources a partir de:
#   - vpc_name (tfvars) → lookup VPC por tag Name
#   - aurora_cluster_identifier (tfvars) → lookup cluster Aurora
# Apenas username e password são necessários aqui para popular o secret
# no Secrets Manager utilizado pelo source endpoint do DMS.
DB_USER=""
DB_PASSWORD=""

# ── Secret existente do DMS (nome NÃO versionado — fica apenas no .env) ──
# Nome do secret existente no Secrets Manager com as credenciais do Aurora.
# É exportado como TF_VAR_db_secret_name para o Terraform e usado pelos
# scripts setup-env.sh e rollback-setup.sh. Preencha com o nome real.
DB_SECRET_NAME=""
